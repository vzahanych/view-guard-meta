edge:
  orchestrator:
    log_level: info
    log_format: json
    data_dir: /var/lib/view-guard-edge
    config_file: /etc/view-guard-edge/config.yaml

  wireguard:
    enabled: true
    config_path: /etc/wireguard/wg0.conf
    kvm_endpoint: ""

  cameras:
    discovery:
      enabled: true
      interval: 300s
    rtsp:
      timeout: 30s
      reconnect_interval: 10s

  storage:
    clips_dir: /var/lib/view-guard-edge/clips
    snapshots_dir: /var/lib/view-guard-edge/snapshots
    retention_days: 7
    max_disk_usage_percent: 80
    # Screenshot storage configuration (Substep 2.2.2.7.1)
    screenshot_retention_days: 0      # Retention for labeled screenshots in days (0 = no automatic deletion)
    screenshot_max_size_mb: 0          # Maximum size per screenshot in MB (0 = no limit, default: no limit)
    screenshot_max_total_size_gb: 0   # Maximum total size for all screenshots in GB (0 = no limit, default: no limit)

  ai:
    service_url: "http://localhost:8080"
    inference_interval: 1s
    confidence_threshold: 0.5
    local_inference_enabled: false
    baseline_label: "normal"
    anomaly_threshold: 12
    clip_duration: 10s
    pre_event_duration: 2s
    dataset_export_dir: ./data/exports
    min_normal_snapshots: 50          # Minimum number of "normal" labeled snapshots required per camera for training (default: 50)

  events:
    queue_size: 1000
    batch_size: 10
    transmission_interval: 5s

  telemetry:
    interval: 60s
    enabled: true

